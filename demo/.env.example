# Names only. Copy to demo/.env.local and fill in locally; never commit real values.
# Public testnet RPCs; values are browser-visible, so use domain-restricted provider credentials.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_NETWORK_MODE=
NEXT_PUBLIC_ANVIL_RPC_A=
NEXT_PUBLIC_ANVIL_RPC_B=
NEXT_PUBLIC_ANVIL_RPC_C=
# Phase 8 relayer HTTP endpoint (defaults to http://127.0.0.1:8787 when unset).
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_SUBMISSION_MODE=
