# Names only. Copy to .env and fill in locally; never commit real values.
# Local anvil (two chains for the multi-chain demo).
ANVIL_RPC=
ANVIL_RPC_B=
# Testnet RPC endpoints (read-only URLs from a provider such as Alchemy).
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Throwaway deployer wallet used by the deploy scripts; never a real-money key.
DEPLOYER_PRIVATE_KEY=
# The user's own MetaMask address: owner of the deployed MandateAccount accounts.
OWNER_ADDRESS=
# Phase 8 relayer wallet; it pays gas and has no authority over funds.
RELAYER_PRIVATE_KEY=
# Throwaway test-only keys: required by the Foundry and SDK test suites, never funded.
TEST_VECTOR_KEY=
OWNER_TEST_KEY=
SESSION_TEST_KEY=
